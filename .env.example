# API key to protect the Meridian endpoint.
# Clients send this via x-api-key or Authorization: Bearer header.
MERIDIAN_API_KEY=change-me

# Claude Max OAuth token (generate locally with: claude setup-token).
# No browser login needed — works headless in the cloud.
MERIDIAN_PROFILES=[{"id":"ci","oauthToken":"sk-ant-oat01-..."}]

# Which profile to use by default.
MERIDIAN_DEFAULT_PROFILE=ci
